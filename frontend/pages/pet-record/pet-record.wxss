.page {
  min-height: 100vh;
  background: #f5f6fa;
  display: flex;
  flex-direction: column;
}

.hero {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  padding: 70rpx 32rpx 50rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.hero-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.summary {
  background: #fff;
  margin: -30rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 28rpx 0;
  display: flex;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.summary-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.summary-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.summary-num.available {
  color: #43e97b;
}

.summary-num.adopted {
  color: #aaa;
}

.summary-label {
  font-size: 24rpx;
  color: #888;
}

.pet-list {
  flex: 1;
  margin-top: 20rpx;
  padding: 0 24rpx 40rpx;
  height: 0;
}

.list-loading,
.list-empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 26rpx;
}

.list-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.empty-icon {
  font-size: 100rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #555;
  font-weight: 600;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
}

.pet-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  transition: opacity 0.2s;
}

.pet-card.adopted {
  opacity: 0.7;
}

.pet-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.pet-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}

.pet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.pet-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.status-pill {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.status-pill.available {
  background: #e7faf1;
  color: #2bb673;
}

.status-pill.adopted {
  background: #f0f0f0;
  color: #888;
}

.status-pill.medical {
  background: #fff4e5;
  color: #ff8a00;
}

.pet-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #777;
  background: #f7f8fb;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.pet-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.pet-location {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.list-footer {
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
  padding: 20rpx 0;
}