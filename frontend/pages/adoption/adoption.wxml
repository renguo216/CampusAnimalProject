<view class="adoption-container">
  <view class="header">
    <view class="top-banner">
      <view class="sticky-post" bindtap="goStickyPost" hover-class="sticky-post-hover">
        <text class="sticky-tag">置顶推文</text>
        <text class="sticky-title">如何科学省钱养宠？新手必看流程</text>
      </view>
    </view>
  </view>

  <view class="quick-links">
    <view class="link-item" bindtap="goPublishAdoption">
      <text class="link-icon">📝</text>
      <text class="link-text">发布领养</text>
    </view>
    <view class="link-item" bindtap="goAddAnimal">
      <text class="link-icon">➕</text>
      <text class="link-text">添加动物</text>
    </view>
    <view class="link-item" bindtap="goPetRecord">
      <text class="link-icon">📋</text>
      <text class="link-text">动物档案</text>
    </view>
  </view>



  <scroll-view class="pet-list" scroll-y enable-back-to-top refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
    <view wx:if="{{loading}}" class="list-loading">
      <text>加载中…</text>
    </view>
    <view wx:elif="{{petList.length === 0}}" class="list-empty">
      <text class="empty-icon">🐾</text>
      <text class="empty-text">还没有待领养的小可爱</text>
      <text class="empty-hint">点击“发布领养”添加一只吧</text>
    </view>
    <view wx:else>
      <view class="pet-card" wx:for="{{petList}}" wx:key="id" bindtap="viewPetDetail" data-id="{{item.id}}">
        <image class="pet-image" src="{{item.image || item.cover || 'https://neeko-copilot.bytedance.net/api/text_to_image?prompt=cute%20pet%20placeholder&image_size=square'}}" mode="aspectFill" />
        <view class="pet-info">
          <view class="pet-header">
            <text class="pet-name">{{item.name}}</text>
            <text class="pet-type">{{item.breed || '校园流浪'}}</text>
          </view>
          <view class="pet-meta">
            <text class="meta-item">{{item.ageText || item.ageLabel}}</text>
            <text class="meta-item">{{item.genderText}}</text>
            <text class="meta-item">{{item.neuteredText}}</text>
          </view>
          <text class="pet-desc">{{item.personality || item.description || '性格温顺，等待有缘人'}}</text>
          <view class="pet-location">
            <text class="location-icon">📍</text>
            <text class="location-text">{{item.foundLocation || item.location || '校园'}}</text>
          </view>
        </view>
      </view>
      <view class="list-footer">
        <text>没有更多待领养小可爱啦~</text>
      </view>
    </view>
  </scroll-view>

  <view class="tab-bar">
    <view class="tab-bar-item" bindtap="goHome">
      <text class="tab-bar-icon">🏠</text>
      <text class="tab-bar-text">首页</text>
    </view>
    <view class="tab-bar-item active">
      <text class="tab-bar-icon">❤️</text>
      <text class="tab-bar-text">领养</text>
    </view>
    <view class="tab-bar-item" bindtap="goCommunity">
      <text class="tab-bar-icon">💬</text>
      <text class="tab-bar-text">社区</text>
    </view>
    <view class="tab-bar-item" bindtap="goProfile">
      <text class="tab-bar-icon">👤</text>
      <text class="tab-bar-text">我的</text>
    </view>
  </view>
</view>