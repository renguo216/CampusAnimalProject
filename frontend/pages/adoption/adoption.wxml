<view class="adoption-container">
  <view class="header">
    <view class="top-banner">
      <view class="sticky-post">
        <text class="sticky-tag">置顶推文</text>
        <text class="sticky-title">如何科学省钱养宠？新手必看流程</text>
        <image class="sticky-image" src="https://neeko-copilot.bytedance.net/api/text_to_image?prompt=cute%20cat%20playing%20with%20toy%20happy&image_size=square" mode="aspectFill" />
      </view>
    </view>
  </view>

  <view class="quick-links">
    <view class="link-item" bindtap="goMap">
      <text class="link-icon">🗺️</text>
      <text class="link-text">寻主地图</text>
    </view>
    <view class="link-item" bindtap="goGroup">
      <text class="link-icon">👥</text>
      <text class="link-text">领养交流群</text>
    </view>
    <view class="link-item" bindtap="goAgreement">
      <text class="link-icon">📄</text>
      <text class="link-text">领养协议</text>
    </view>
  </view>

  <view class="filter-bar">
    <view class="filter-tabs">
      <view class="filter-tab {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">
        <text>全部</text>
      </view>
      <view class="filter-tab {{currentTab === 'cat' ? 'active' : ''}}" bindtap="switchTab" data-tab="cat">
        <text>小猫</text>
      </view>
      <view class="filter-tab {{currentTab === 'dog' ? 'active' : ''}}" bindtap="switchTab" data-tab="dog">
        <text>小狗</text>
      </view>
    </view>
    <view class="filter-btn" bindtap="showFilter">
      <text>筛选</text>
      <text class="filter-arrow">›</text>
    </view>
  </view>

  <scroll-view class="pet-list" scroll-y>
    <view class="pet-card" wx:for="{{petList}}" wx:key="id" bindtap="viewPetDetail" data-id="{{item.id}}">
      <image class="pet-image" src="{{item.image}}" mode="aspectFill" />
      <view class="pet-info">
        <view class="pet-header">
          <text class="pet-name">{{item.name}}</text>
          <text class="pet-type">{{item.type}}</text>
        </view>
        <view class="pet-meta">
          <text class="meta-item">{{item.age}}</text>
          <text class="meta-item">{{item.gender}}</text>
          <text class="meta-item">{{item.sterilized}}</text>
        </view>
        <text class="pet-desc">{{item.description}}</text>
        <view class="pet-location">
          <text class="location-icon">📍</text>
          <text class="location-text">{{item.location}}</text>
        </view>
      </view>
    </view>
    <view class="list-footer">
      <text>没有更多待领养小可爱啦~</text>
    </view>
  </scroll-view>

  <view class="tab-bar">
    <view class="tab-bar-item" bindtap="goHome">
      <text class="tab-bar-icon">🏠</text>
      <text class="tab-bar-text">首页</text>
    </view>
    <view class="tab-bar-item active">
      <text class="tab-bar-icon">❤️</text>
      <text class="tab-bar-text">领养</text>
    </view>
    <view class="tab-bar-item" bindtap="goCommunity">
      <text class="tab-bar-icon">💬</text>
      <text class="tab-bar-text">社区</text>
    </view>
    <view class="tab-bar-item" bindtap="goProfile">
      <text class="tab-bar-icon">👤</text>
      <text class="tab-bar-text">我的</text>
    </view>
  </view>

  <view class="apply-modal" wx:if="{{showApplyModal}}">
    <view class="modal-mask" bindtap="closeApplyModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">领养申请</text>
        <view class="modal-close" bindtap="closeApplyModal">×</view>
      </view>
      
      <view class="pet-preview" wx:if="{{selectedPet}}">
        <image class="preview-image" src="{{selectedPet.image}}" mode="aspectFill" />
        <view class="preview-info">
          <text class="preview-name">{{selectedPet.name}}</text>
          <text class="preview-meta">{{selectedPet.age}} · {{selectedPet.gender}}</text>
        </view>
      </view>

      <view class="apply-form">
        <view class="form-item">
          <text class="form-label">姓名</text>
          <input class="form-input" placeholder="请输入您的姓名" bindinput="onNameInput" value="{{applyForm.name}}" />
        </view>

        <view class="form-item">
          <text class="form-label">手机号</text>
          <input class="form-input" type="number" placeholder="请输入手机号" bindinput="onPhoneInput" value="{{applyForm.phone}}" />
        </view>

        <view class="form-item">
          <text class="form-label">职业</text>
          <input class="form-input" placeholder="请输入您的职业" bindinput="onJobInput" value="{{applyForm.job}}" />
        </view>

        <view class="form-item">
          <text class="form-label">居住环境</text>
          <view class="radio-group">
            <view class="radio-item {{applyForm.housing === 'owned' ? 'active' : ''}}" bindtap="selectHousing" data-type="owned">
              <text>自有住房</text>
            </view>
            <view class="radio-item {{applyForm.housing === 'rented' ? 'active' : ''}}" bindtap="selectHousing" data-type="rented">
              <text>租房</text>
            </view>
          </view>
        </view>

        <view class="form-item">
          <text class="form-label">养宠经验</text>
          <view class="radio-group">
            <view class="radio-item {{applyForm.experience === 'none' ? 'active' : ''}}" bindtap="selectExperience" data-type="none">
              <text>无经验</text>
            </view>
            <view class="radio-item {{applyForm.experience === 'some' ? 'active' : ''}}" bindtap="selectExperience" data-type="some">
              <text>有一些</text>
            </view>
            <view class="radio-item {{applyForm.experience === 'rich' ? 'active' : ''}}" bindtap="selectExperience" data-type="rich">
              <text>经验丰富</text>
            </view>
          </view>
        </view>

        <view class="form-item">
          <text class="form-label">申请理由</text>
          <textarea class="form-textarea" placeholder="请简要说明您想要领养这只小动物的原因..." bindinput="onReasonInput" value="{{applyForm.reason}}" />
        </view>

        <view class="agreement-row">
          <checkbox-group bindchange="onAgreementChange">
            <label class="agreement-label">
              <checkbox value="agreed" checked="{{applyForm.agreed}}" />
              <text>我已阅读并同意《领养协议》</text>
            </label>
          </checkbox-group>
        </view>
      </view>

      <button class="submit-btn" bindtap="submitApplication">提交申请</button>
    </view>
  </view>
</view>