page {
  background-color: #fdf8f3;
  min-height: 100vh;
}

.adoption-container {
  padding-bottom: 120rpx;
}

.header {
  padding-top: 160rpx;
}

.top-banner {
  padding: 0 30rpx;
}

.sticky-post {
  background: linear-gradient(135deg, #ff9f00 0%, #ffb800 100%);
  border-radius: 25rpx;
  padding: 35rpx 30rpx;
  position: relative;
}

.sticky-post-hover {
  opacity: 0.9;
  transform: scale(0.99);
  transition: all 0.2s ease;
}

.sticky-tag {
  display: inline-block;
  background-color: rgba(255, 255, 255, 0.3);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #ffffff;
  margin-bottom: 15rpx;
}

.sticky-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
}

.quick-links {
  display: flex;
  justify-content: space-around;
  padding: 30rpx;
  background-color: #ffffff;
  margin: 30rpx;
  border-radius: 20rpx;
}

.link-item {
  text-align: center;
}

.link-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.link-text {
  font-size: 24rpx;
  color: #666666;
}

.pet-list {
  height: calc(100vh - 500rpx);
  padding: 0 30rpx;
  margin-top: 20rpx;
}

.pet-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  display: flex;
}

.pet-image {
  width: 220rpx;
  height: 220rpx;
  border-radius: 15rpx;
  margin-right: 25rpx;
  background-color: #f5f5f5;
}

.pet-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.pet-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.pet-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-right: 15rpx;
}

.pet-type {
  font-size: 22rpx;
  padding: 6rpx 15rpx;
  background-color: #fff3e6;
  color: #ff9f00;
  border-radius: 15rpx;
}

.pet-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 15rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999999;
}

.pet-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.pet-location {
  display: flex;
  align-items: center;
  margin-top: auto;
}

.location-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.location-text {
  font-size: 24rpx;
  color: #999999;
}

.list-footer {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999999;
}

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  background-color: #ffffff;
  padding: 20rpx 0;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.tab-bar-item {
  text-align: center;
}

.tab-bar-icon {
  display: block;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.tab-bar-text {
  font-size: 22rpx;
  color: #999999;
}

.tab-bar-item.active .tab-bar-text {
  color: #ff9f00;
}

.apply-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  max-height: 85vh;
  overflow-y: auto;
  padding-bottom: 60rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.modal-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 50rpx;
  color: #cccccc;
}

.pet-preview {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: #fdf8f3;
}

.preview-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 15rpx;
  margin-right: 25rpx;
}

.preview-info {
  flex: 1;
}

.preview-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.preview-meta {
  font-size: 26rpx;
  color: #999999;
}

.apply-form {
  padding: 0 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 15rpx;
}

.form-input {
  width: 100%;
  height: 90rpx;
  background-color: #fdf8f3;
  border-radius: 15rpx;
  padding: 0 25rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 150rpx;
  background-color: #fdf8f3;
  border-radius: 15rpx;
  padding: 25rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.radio-group {
  display: flex;
  gap: 15rpx;
}

.radio-item {
  flex: 1;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 15rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
}

.radio-item.active {
  background-color: #ff9f00;
  color: #ffffff;
}

.agreement-row {
  margin-bottom: 30rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666666;
}

.submit-btn {
  margin: 0 30rpx;
  height: 100rpx;
  background: linear-gradient(90deg, #d46b08 0%, #ff9f00 100%);
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}