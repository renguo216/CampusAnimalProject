/* pages/home/home.wxss */
page {
  background-color: #fdf8f3;
  height: 100%;
}

.home-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 120rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 160rpx 30rpx 30rpx;
  background-color: #ffffff;
}

.location {
  display: flex;
  align-items: center;
}

.location-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.location-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f4f4f4;
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
  margin-left: 20rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-placeholder {
  color: #cccccc;
}

.banner {
  margin: 0 30rpx 30rpx;
  background: linear-gradient(135deg, #fff3e6 0%, #ffe4c4 100%);
  border-radius: 30rpx;
  padding: 40rpx;
}

.banner-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.banner-text {
  flex: 1;
}

.banner-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #8b4513;
  margin-bottom: 8rpx;
}

.banner-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  overflow: hidden;
  box-shadow: 0 4rpx 15rpx rgba(255, 153, 0, 0.2);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 0 30rpx;
  margin-bottom: 30rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 25rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  margin-bottom: 15rpx;
}

.action-icon.pink {
  background-color: #ffe4ec;
}

.action-icon.blue {
  background-color: #e6f3ff;
}

.action-icon.green {
  background-color: #e6ffed;
}

.action-icon.orange {
  background-color: #fff7e6;
}

.action-text {
  font-size: 24rpx;
  color: #666666;
}

.tabs {
  display: flex;
  justify-content: space-around;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 15rpx 30rpx;
}

.tab-item text {
  font-size: 30rpx;
  color: #999999;
  transition: color 0.3s;
}

.tab-item.active text {
  color: #ff9f00;
  font-weight: bold;
}

.tab-indicator {
  width: 40rpx;
  height: 6rpx;
  background-color: #ff9f00;
  border-radius: 3rpx;
  margin-top: 10rpx;
}

.rescue-list {
  height: calc(100vh - 580rpx);
  padding: 0 30rpx;
  box-sizing: border-box;
}

.rescue-card {
  display: flex;
  background-color: #ffffff;
  border-radius: 25rpx;
  padding: 20rpx;
  margin-bottom: 25rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.rescue-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.rescue-info {
  flex: 1;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.rescue-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.rescue-specie {
  font-size: 24rpx;
  color: #666666;
}

.rescue-needs {
  font-size: 24rpx;
  color: #ff4d4f;
}

.rescue-location {
  display: flex;
  align-items: center;
}

.location-icon-small {
  font-size: 20rpx;
  margin-right: 8rpx;
}

.location-text-small {
  font-size: 22rpx;
  color: #999999;
}

.list-footer {
  text-align: center;
  padding: 30rpx;
}

.list-footer text {
  font-size: 24rpx;
  color: #cccccc;
}

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  background-color: #ffffff;
  padding: 15rpx 0 35rpx;
  box-shadow: 0 -4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tab-bar-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.tab-bar-text {
  font-size: 22rpx;
  color: #999999;
}

.tab-bar-item.active .tab-bar-icon {
  color: #ff9f00;
}

.tab-bar-item.active .tab-bar-text {
  color: #ff9f00;
  font-weight: bold;
}