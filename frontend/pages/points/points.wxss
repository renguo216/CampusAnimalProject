page {
  background-color: #fdf8f3;
  min-height: 100vh;
}

.points-container {
  padding-bottom: 60rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 30rpx 30rpx;
  background-color: #ffffff;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: #333333;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.placeholder {
  width: 60rpx;
}

.points-card {
  margin: 30rpx;
  background: linear-gradient(135deg, #ff9f00 0%, #ffb800 100%);
  border-radius: 25rpx;
  padding: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 159, 0, 0.3);
}

.points-info {
  display: flex;
  flex-direction: column;
}

.points-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 10rpx;
}

.points-value {
  font-size: 60rpx;
  font-weight: bold;
  color: #ffffff;
}

.points-history-btn {
  padding: 15rpx 30rpx;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #ffffff;
}

.tabs {
  display: flex;
  margin: 0 30rpx 20rpx;
  background-color: #ffffff;
  border-radius: 15rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  padding: 25rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  position: relative;
}

.tab-item.active {
  color: #ff9f00;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #ff9f00;
  border-radius: 3rpx;
}

.products-list {
  padding: 0 30rpx;
}

.product-item {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  display: flex;
}

.product-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 15rpx;
  margin-right: 25rpx;
  background-color: #f5f5f5;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.product-desc {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: auto;
  line-height: 1.5;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-points {
  display: flex;
  align-items: center;
}

.points-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.points-num {
  font-size: 28rpx;
  color: #ff9f00;
  font-weight: bold;
}

.exchange-btn {
  padding: 15rpx 35rpx;
  background: linear-gradient(90deg, #ff9f00 0%, #ffb800 100%);
  color: #ffffff;
  border-radius: 30rpx;
  font-size: 26rpx;
  border: none;
}

.exchange-btn.disabled {
  background-color: #cccccc;
  color: #ffffff;
}

.records-list {
  padding: 0 30rpx;
}

.record-item {
  background-color: #ffffff;
  border-radius: 15rpx;
  padding: 30rpx;
  margin-bottom: 15rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-info {
  display: flex;
  flex-direction: column;
}

.record-name {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 10rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999999;
}

.record-points {
  text-align: right;
  display: flex;
  flex-direction: column;
}

.record-points text:first-child {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.record-status {
  font-size: 24rpx;
}

.record-status.pending {
  color: #ff9f00;
}

.record-status.completed {
  color: #52c41a;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: #999999;
}