<view class="points-container">
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text>←</text>
    </view>
    <text class="header-title">积分商城</text>
    <view class="placeholder"></view>
  </view>

  <view class="points-card">
    <text class="points-label">我的积分</text>
    <text class="points-value">{{myPoints}}</text>
    <text class="points-tips">通过参与救助、志愿服务等获取积分</text>
  </view>

  <view class="tabs">
    <view class="tab-item {{activeTab === 'products' ? 'active' : ''}}" bindtap="switchTab" data-tab="products">
      <text>积分商品</text>
    </view>
    <view class="tab-item {{activeTab === 'records' ? 'active' : ''}}" bindtap="switchTab" data-tab="records">
      <text>兑换记录</text>
    </view>
  </view>

  <view class="tab-content">
    <view wx:if="{{activeTab === 'products'}}">
      <view wx:if="{{productsLoading}}" class="loading-tip">
        <text>加载中...</text>
      </view>
      <view wx:elif="{{products.length === 0}}" class="empty-tip">
        <text>暂无商品</text>
      </view>
      <view class="products-list" wx:else>
        <view class="product-item" wx:for="{{products}}" wx:key="id" bindtap="exchangeProduct" data-id="{{item.id}}" data-points="{{item.points}}">
          <image class="product-image" src="{{item.image}}" mode="aspectFill" />
          <view class="product-info">
            <text class="product-name">{{item.name}}</text>
            <text class="product-desc">{{item.description}}</text>
            <view class="product-bottom">
              <text class="product-points">{{item.points}}积分</text>
              <text class="product-stock">库存: {{item.stock}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{activeTab === 'records'}}">
      <view wx:if="{{recordsLoading}}" class="loading-tip">
        <text>加载中...</text>
      </view>
      <view wx:elif="{{exchangeRecords.length === 0}}" class="empty-tip">
        <text>暂无兑换记录</text>
      </view>
      <view class="records-list" wx:else>
        <view class="record-item" wx:for="{{exchangeRecords}}" wx:key="id">
          <view class="record-info">
            <text class="record-name">{{item.productName}}</text>
            <text class="record-time">{{item.exchangeTime}}</text>
          </view>
          <view class="record-right">
            <text class="record-points">-{{item.points}}</text>
            <text class="record-status {{item.status}}">{{item.statusText}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>