<view class="community-container">
  <view class="header">
    <view class="user-avatar" bindtap="goProfile">
      <image class="avatar-img" src="{{userAvatar}}" mode="aspectFill" />
    </view>
    <view class="search-box" bindtap="focusSearch">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索救助攻略、寻宠信息..." placeholder-class="search-placeholder" value="{{searchKeyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="doSearch" />
    </view>
    <view class="camera-btn" bindtap="createPost">
      <text>📷</text>
    </view>
  </view>

  <view class="tabs">
    <view class="tab-item {{currentTab === 'follow' ? 'active' : ''}}" bindtap="switchTab" data-tab="follow">
      <text>关注</text>
    </view>
    <view class="tab-item {{currentTab === 'recommend' ? 'active' : ''}}" bindtap="switchTab" data-tab="recommend">
      <text>推荐</text>
    </view>
  </view>

  <scroll-view class="post-list" scroll-y bindscrolltolower="loadMore">
    <view class="post-card" wx:for="{{posts}}" wx:key="id" bindtap="viewPostDetail" data-id="{{item.id}}">
      <view class="post-header">
        <image class="post-avatar" src="{{item.avatar}}" mode="aspectFill" />
        <view class="post-author">
          <text class="author-name">{{item.author}}</text>
          <text class="author-time">{{item.createTime}}</text>
        </view>
        <view class="post-more" bindtap="showPostMenu" data-id="{{item.id}}">
          <text>⋯</text>
        </view>
      </view>
      
      <text class="post-content">{{item.content}}</text>
      
      <view class="post-images" wx:if="{{item.images && item.images.length > 0}}">
        <image class="post-image" wx:for="{{item.images}}" wx:key="index" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-images="{{item.images}}" data-index="{{index}}" />
      </view>
      
      <view class="post-stats">
        <view class="stat-item" bindtap="likePost" data-id="{{item.id}}" catchtap="true">
          <text class="stat-icon {{item.isLiked ? 'liked' : ''}}">❤️</text>
          <text class="stat-value">{{item.likes}}</text>
        </view>
        <view class="stat-item" bindtap="commentPost" data-id="{{item.id}}" catchtap="true">
          <text class="stat-icon">💬</text>
          <text class="stat-value">{{item.comments}}</text>
        </view>
        <view class="stat-item" bindtap="sharePost" data-id="{{item.id}}" catchtap="true">
          <text class="stat-icon">🔄</text>
          <text class="stat-value">转发</text>
        </view>
      </view>
    </view>

    <view class="loading-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="no-more" wx:if="{{!loading && !hasMore}}">
      <text>已经到底了~</text>
    </view>
  </scroll-view>

  <view class="post-modal" wx:if="{{showPostModal}}">
    <view class="modal-mask" bindtap="closePostModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">发布帖子</text>
        <view class="modal-close" bindtap="closePostModal">×</view>
      </view>
      
      <view class="post-form">
        <textarea class="post-textarea" placeholder="分享你的救助故事、寻宠信息或心得体会..." bindinput="onPostContentInput" value="{{postContent}}" />
        
        <view class="upload-section">
          <text class="upload-label">添加图片（可选）</text>
          <view class="upload-area">
            <view class="upload-item add-btn" bindtap="chooseImages" wx:if="{{postImages.length < 9}}">
              <text class="add-icon">📷</text>
              <text class="add-text">添加</text>
            </view>
            <view class="upload-item" wx:for="{{postImages}}" wx:key="index">
              <image src="{{item}}" mode="aspectFill" />
              <view class="delete-btn" bindtap="deletePostImage" data-index="{{index}}">×</view>
            </view>
          </view>
        </view>

        <view class="post-tags">
          <text class="tags-label">选择话题</text>
          <view class="tags-list">
            <view class="tag-item {{selectedTags.includes('rescue') ? 'active' : ''}}" bindtap="toggleTag" data-tag="rescue">
              <text>🐾 救助故事</text>
            </view>
            <view class="tag-item {{selectedTags.includes('find') ? 'active' : ''}}" bindtap="toggleTag" data-tag="find">
              <text>🔍 寻宠/寻主</text>
            </view>
            <view class="tag-item {{selectedTags.includes('adoption') ? 'active' : ''}}" bindtap="toggleTag" data-tag="adoption">
              <text>🏠 领养信息</text>
            </view>
            <view class="tag-item {{selectedTags.includes('experience') ? 'active' : ''}}" bindtap="toggleTag" data-tag="experience">
              <text>💡 经验分享</text>
            </view>
          </view>
        </view>

        <button class="submit-btn" bindtap="submitPost">发布</button>
      </view>
    </view>
  </view>

  <view class="comment-modal" wx:if="{{showCommentModal}}">
    <view class="modal-mask" bindtap="closeCommentModal"></view>
    <view class="comment-content">
      <view class="modal-header">
        <text class="modal-title">评论</text>
        <view class="modal-close" bindtap="closeCommentModal">×</view>
      </view>
      
      <scroll-view class="comments-list" scroll-y>
        <view class="comment-item" wx:for="{{currentComments}}" wx:key="id">
          <image class="comment-avatar" src="{{item.avatar}}" mode="aspectFill" />
          <view class="comment-body">
            <view class="comment-header">
              <text class="comment-author">{{item.author}}</text>
              <text class="comment-time">{{item.time}}</text>
            </view>
            <text class="comment-text">{{item.content}}</text>
          </view>
        </view>
        <view class="empty-comments" wx:if="{{currentComments.length === 0}}">
          <text>暂无评论，快来抢沙发~</text>
        </view>
      </scroll-view>
      
      <view class="comment-input-area">
        <input class="comment-input" placeholder="写下你的评论..." value="{{commentText}}" bindinput="onCommentInput" confirm-type="send" bindconfirm="submitComment" />
        <button class="send-btn" bindtap="submitComment">发送</button>
      </view>
    </view>
  </view>

  <view class="tab-bar">
    <view class="tab-bar-item" bindtap="goHome">
      <text class="tab-bar-icon">🏠</text>
      <text class="tab-bar-text">首页</text>
    </view>
    <view class="tab-bar-item" bindtap="goAdoption">
      <text class="tab-bar-icon">❤️</text>
      <text class="tab-bar-text">领养</text>
    </view>
    <view class="tab-bar-item active">
      <text class="tab-bar-icon">💬</text>
      <text class="tab-bar-text">社区</text>
    </view>
    <view class="tab-bar-item" bindtap="goProfile">
      <text class="tab-bar-icon">👤</text>
      <text class="tab-bar-text">我的</text>
    </view>
  </view>
</view>