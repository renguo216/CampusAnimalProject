page {
  background-color: #fdf8f3;
  min-height: 100vh;
}

.community-container {
  padding-bottom: 120rpx;
}

.header {
  display: flex;
  align-items: center;
  padding: 160rpx 30rpx 30rpx;
  background-color: #ffffff;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 40rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 18rpx 25rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-placeholder {
  color: #cccccc;
}

.camera-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  margin-left: 20rpx;
}

.tabs {
  display: flex;
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #999999;
  padding: 15rpx 0;
  position: relative;
}

.tab-item.active {
  color: #ff9f00;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #ff9f00;
  border-radius: 3rpx;
}

.post-list {
  height: calc(100vh - 450rpx);
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

.post-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.post-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 35rpx;
  margin-right: 20rpx;
}

.post-author {
  flex: 1;
}

.author-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 5rpx;
}

.author-id {
  font-size: 24rpx;
  color: #999999;
}

.author-time {
  font-size: 24rpx;
  color: #999999;
}

.post-more {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  color: #999999;
}

.post-content {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.6;
  margin-bottom: 20rpx;
  white-space: pre-wrap;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.post-image {
  width: calc(33.33% - 7rpx);
  aspect-ratio: 1;
  border-radius: 10rpx;
}

.post-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.stat-item {
  display: flex;
  align-items: center;
}

.stat-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.stat-icon.liked {
  color: #ff4d4f;
}

.stat-value {
  font-size: 26rpx;
  color: #666666;
}

.loading-more, .no-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: #999999;
}

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  background-color: #ffffff;
  padding: 20rpx 0;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.tab-bar-item {
  text-align: center;
}

.tab-bar-icon {
  display: block;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.tab-bar-text {
  font-size: 22rpx;
  color: #999999;
}

.tab-bar-item.active .tab-bar-text {
  color: #ff9f00;
}

.post-modal, .comment-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  max-height: 85vh;
  overflow-y: auto;
  padding-bottom: 60rpx;
}

.comment-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  height: 70vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.modal-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 50rpx;
  color: #cccccc;
}

.post-form {
  padding: 30rpx;
}

.post-textarea {
  width: 100%;
  height: 250rpx;
  background-color: #fdf8f3;
  border-radius: 15rpx;
  padding: 25rpx;
  font-size: 30rpx;
  color: #333333;
  box-sizing: border-box;
  margin-bottom: 30rpx;
}

.upload-section {
  margin-bottom: 30rpx;
}

.upload-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 15rpx;
}

.upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.upload-item {
  width: 140rpx;
  height: 140rpx;
  border-radius: 15rpx;
  overflow: hidden;
  position: relative;
}

.upload-item image {
  width: 100%;
  height: 100%;
}

.add-btn {
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 2rpx dashed #ddd;
}

.add-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 22rpx;
  color: #999999;
}

.delete-btn {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 35rpx;
  height: 35rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
}

.post-tags {
  margin-bottom: 30rpx;
}

.tags-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 15rpx;
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.tag-item {
  padding: 15rpx 25rpx;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666666;
}

.tag-item.active {
  background-color: #ff9f00;
  color: #ffffff;
}

.submit-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(90deg, #d46b08 0%, #ff9f00 100%);
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.comments-list {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

.comment-item {
  display: flex;
  margin-bottom: 25rpx;
}

.comment-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  margin-right: 20rpx;
}

.comment-body {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.comment-author {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
}

.comment-time {
  font-size: 22rpx;
  color: #999999;
}

.comment-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
}

.empty-comments {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #999999;
}

.comment-input-area {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f5f5f5;
  background-color: #ffffff;
}

.comment-input {
  flex: 1;
  height: 70rpx;
  background-color: #f5f5f5;
  border-radius: 35rpx;
  padding: 0 25rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 20rpx;
  padding: 15rpx 40rpx;
  background-color: #ff9f00;
  color: #ffffff;
  border-radius: 35rpx;
  font-size: 28rpx;
  border: none;
}