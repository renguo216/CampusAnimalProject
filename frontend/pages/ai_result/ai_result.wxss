/* pages/ai_result/ai_result.wxss */
page {
  background-color: #fdf8f3;
  min-height: 100vh;
}

.ai-container {
  padding-bottom: 140rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 30rpx 30rpx;
  background-color: #ffffff;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: #333333;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.placeholder {
  width: 60rpx;
}

.result-card {
  margin: 30rpx;
  background-color: #ffffff;
  border-radius: 30rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.08);
}

.image-container {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.result-image {
  width: 100%;
  height: 100%;
}

.success-badge {
  position: absolute;
  left: 30rpx;
  top: 20rpx;
  background-color: #52c41a;
  color: #ffffff;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.result-info {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.breed-name {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.breed-english {
  font-size: 26rpx;
  color: #999999;
}

.paw-icon {
  font-size: 50rpx;
}

.section {
  background-color: #ffffff;
  margin: 0 30rpx 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.character-desc {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.7;
  margin-bottom: 25rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 40rpx;
  background-color: #f9f9f9;
  border-radius: 15rpx;
}

.stat-icon {
  font-size: 36rpx;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 5rpx;
}

.stat-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.tips-list {
  padding-left: 10rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 15rpx;
}

.tip-icon {
  color: #52c41a;
  font-size: 28rpx;
  margin-right: 15rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
}

.action-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50rpx;
  font-size: 28rpx;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(90deg, #d46b08 0%, #ff9f00 100%);
  color: #ffffff;
}

.action-btn.secondary {
  background-color: #ffffff;
  color: #ff9f00;
  border: 2rpx solid #ff9f00;
}

.btn-icon {
  margin-right: 10rpx;
}

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  background-color: #ffffff;
  padding: 15rpx 0 35rpx;
  box-shadow: 0 -4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tab-bar-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.tab-bar-text {
  font-size: 22rpx;
  color: #999999;
}