page {
  background-color: #fdf8f3;
  min-height: 100vh;
}

.report-container {
  padding-bottom: 120rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 30rpx 30rpx;
  background-color: #ffffff;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: #333333;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.placeholder {
  width: 60rpx;
}

.banner {
  margin: 30rpx;
  background: linear-gradient(135deg, #fff3e6 0%, #ffe4c4 100%);
  border-radius: 25rpx;
  padding: 40rpx;
  position: relative;
}

.banner-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #8b4513;
  margin-bottom: 15rpx;
}

.banner-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.paw-print {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  font-size: 60rpx;
  opacity: 0.5;
}

.section {
  background-color: #ffffff;
  margin: 0 30rpx 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.upload-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 15rpx;
  overflow: hidden;
  position: relative;
}

.upload-item image {
  width: 100%;
  height: 100%;
}

.add-btn {
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 2rpx dashed #ddd;
}

.add-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.add-text {
  font-size: 24rpx;
  color: #999999;
}

.delete-btn {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
}

.ai-identify-btn {
  margin-top: 20rpx;
  padding: 20rpx;
  background: linear-gradient(90deg, #52c41a 0%, #73d13d 100%);
  color: #ffffff;
  border-radius: 15rpx;
  text-align: center;
  font-size: 28rpx;
}

.identify-result {
  background-color: #f6ffed;
  border-radius: 15rpx;
  padding: 20rpx;
}

.result-row {
  display: flex;
  margin-bottom: 10rpx;
}

.result-row:last-child {
  margin-bottom: 0;
}

.result-label {
  font-size: 28rpx;
  color: #666666;
  width: 120rpx;
}

.result-value {
  font-size: 28rpx;
  color: #333333;
  flex: 1;
}

.desc-input {
  width: 100%;
  height: 200rpx;
  background-color: #fdf8f3;
  border-radius: 15rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.location-input {
  display: flex;
  align-items: center;
  background-color: #fdf8f3;
  border-radius: 15rpx;
  padding: 25rpx;
}

.location-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
}

.location-text {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.help-options {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.help-item {
  padding: 18rpx 30rpx;
  background-color: #f5f5f5;
  border-radius: 50rpx;
  font-size: 26rpx;
  color: #666666;
}

.help-item.active {
  background-color: #ff9f00;
  color: #ffffff;
}

.submit-btn {
  margin: 40rpx 30rpx;
  height: 100rpx;
  background: linear-gradient(90deg, #d46b08 0%, #ff9f00 100%);
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(212, 107, 8, 0.3);
}

.footer-text {
  text-align: center;
  margin-bottom: 15rpx;
}

.footer-text text {
  font-size: 22rpx;
  color: #999999;
}