<view class="task-container">
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text>←</text>
    </view>
    <text class="header-title">救助任务</text>
    <view class="placeholder"></view>
  </view>

  <view class="stats-bar">
    <view class="stat-item">
      <text class="stat-num">{{stats.pending}}</text>
      <text class="stat-label">待接单</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.processing}}</text>
      <text class="stat-label">进行中</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.completed}}</text>
      <text class="stat-label">已完成</text>
    </view>
  </view>

  <view class="tabs">
    <view class="tab-item {{activeTab === 'available' ? 'active' : ''}}" bindtap="switchTab" data-tab="available">
      <text>可接任务</text>
      <view class="tab-badge" wx:if="{{availableCount > 0}}">{{availableCount}}</view>
    </view>
    <view class="tab-item {{activeTab === 'my' ? 'active' : ''}}" bindtap="switchTab" data-tab="my">
      <text>我的任务</text>
    </view>
  </view>

  <view class="task-list">
    <view class="task-item" wx:for="{{tasks}}" wx:key="id">
      <view class="task-header">
        <text class="task-type">{{item.typeText}}</text>
        <text class="task-status {{item.status}}">{{item.statusText}}</text>
      </view>
      
      <view class="task-content" bindtap="viewTaskDetail" data-id="{{item.id}}">
        <image class="task-image" src="{{item.image}}" mode="aspectFill" />
        <view class="task-info">
          <text class="task-title">{{item.title}}</text>
          <view class="task-meta">
            <text class="meta-item">📍 {{item.location}}</text>
            <text class="meta-item">⏰ {{item.time}}</text>
          </view>
          <text class="task-desc">{{item.description}}</text>
        </view>
      </view>

      <view class="task-actions">
        <button class="action-btn reject" wx:if="{{item.showReject}}" bindtap="rejectTask" data-id="{{item.id}}">
          拒单
        </button>
        <button class="action-btn accept" wx:if="{{item.showAccept}}" bindtap="acceptTask" data-id="{{item.id}}">
          接单
        </button>
        <button class="action-btn navigate" wx:if="{{item.showNavigate}}" bindtap="navigateToLocation" data-lat="{{item.latitude}}" data-lng="{{item.longitude}}">
          导航
        </button>
        <button class="action-btn complete" wx:if="{{item.showComplete}}" bindtap="completeTask" data-id="{{item.id}}">
          完成
        </button>
      </view>
    </view>

    <view class="empty-tip" wx:if="{{tasks.length === 0}}">
      <text>暂无任务</text>
    </view>
  </view>
</view>