.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.header {
  width: 100%;
  padding-top: 0;
  padding-bottom: 30rpx;
  background: linear-gradient(135deg, #ff9f00 0%, #ff6b00 100%);
}

.header-content {
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  padding-top: 80rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #ffffff;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  margin-left: 50rpx;
}

.scroll-content {
  flex: 1;
  padding: 30rpx;
  padding-bottom: 200rpx;
}

.section {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 30rpx;
  padding-left: 15rpx;
  border-left: 6rpx solid #ff9f00;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 15rpx;
}

.form-input {
  width: 100%;
  height: 90rpx;
  background-color: #f8f8f8;
  border-radius: 10rpx;
  padding: 0 25rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  background-color: #f8f8f8;
  border-radius: 10rpx;
  padding: 20rpx 25rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.picker-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 90rpx;
  background-color: #f8f8f8;
  border-radius: 10rpx;
  padding: 0 25rpx;
  box-sizing: border-box;
}

.picker-text {
  font-size: 28rpx;
  color: #333333;
}

.picker-text.placeholder {
  color: #cccccc;
}

.picker-arrow {
  font-size: 40rpx;
  color: #cccccc;
  font-weight: bold;
}

.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag-item {
  flex: 1;
  min-width: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  border: 2rpx solid #e0e0e0;
  font-size: 26rpx;
  color: #666666;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.tag-item.active {
  background-color: #ff9f00;
  border: 2rpx solid #ff9f00;
  color: #ffffff;
  font-weight: bold;
}

.upload-section {
  width: 100%;
}

.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.image-preview {
  width: 100%;
  height: 100%;
  border-radius: 15rpx;
}

.delete-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 44rpx;
  height: 44rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  background-color: #f8f8f8;
  border-radius: 15rpx;
  border: 2rpx dashed #dddddd;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 60rpx;
  color: #cccccc;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999999;
}

.upload-tip {
  font-size: 24rpx;
  color: #999999;
  margin-top: 20rpx;
  text-align: center;
}

.spacer {
  height: 60rpx;
}

.bottom-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  padding-bottom: 50rpx;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.btn {
  flex: 1;
  height: 90rpx;
  border-radius: 45rpx;
  font-size: 30rpx;
  border: none;
}

.btn-cancel {
  background-color: #f5f5f5;
  color: #666666;
}

.btn-draft {
  background-color: #fff5e6;
  color: #ff9f00;
}

.btn-submit {
  background: linear-gradient(135deg, #ff9f00 0%, #ff6b00 100%);
  color: #ffffff;
}
