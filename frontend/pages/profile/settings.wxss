page {
  background-color: #FFF8E7;
}

.container {
  padding: 0 30rpx 30rpx 30rpx;
  background-color: #FFF8E7;
  min-height: 100vh;
}

.header {
  padding-top: 200rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.section {
  background-color: #fff;
  border-radius: 0;
  margin-bottom: 30rpx;
  overflow: hidden;
  width: 100%;
}

.section-title {
  font-size: 28rpx;
  color: #999;
  padding: 30rpx 30rpx 20rpx 30rpx;
  font-weight: normal;
}

.settings-list {
  display: flex;
  flex-direction: column;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 30rpx;
  color: #333;
}

.setting-value {
  display: flex;
  align-items: center;
}

.version {
  font-size: 26rpx;
  color: #999;
  margin-right: 20rpx;
}

.setting-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.logout-section {
  margin-top: 60rpx;
  padding: 0;
}

.logout-btn {
  width: 100%;
  background-color: #fff;
  color: #f44336;
  padding: 25rpx 0;
  border-radius: 50rpx;
  font-size: 30rpx;
  border: 2rpx solid #f44336;
}

.logout-btn::after {
  border: none;
}