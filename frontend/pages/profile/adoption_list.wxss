page {
  background-color: #FFF8E7;
}

.container {
  padding: 0 30rpx 30rpx 30rpx;
  background-color: #FFF8E7;
}

.header {
  text-align: center;
  padding-top: 160rpx;
  margin-bottom: 140rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.empty-tip {
  text-align: center;
  color: #999;
  margin-top: 100rpx;
  font-size: 28rpx;
}

.adoption-list {
  display: flex;
  flex-direction: column;
}

.adoption-card {
  display: flex;
  align-items: center;
  background-color: transparent;
  padding: 30rpx 0;
  margin-bottom: 30rpx;
  width: 100%;
}

.pet-avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background-color: #eee;
  flex-shrink: 0;
}

.adoption-info {
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.pet-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: flex;
  align-items: center;
}

.gender {
  color: #ff6b81;
  margin-left: 10rpx;
  font-size: 32rpx;
}

.pet-breed {
  font-size: 28rpx;
  color: #666;
  margin-top: 15rpx;
}

.adoption-time {
  font-size: 26rpx;
  color: #999;
  margin-top: 15rpx;
}

.status-badge {
  margin-top: 15rpx;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  display: inline-block;
  width: fit-content;
}

.status-0 {
  background-color: #fff3e0;
  color: #ff9800;
}

.status-1 {
  background-color: #e8f5e9;
  color: #4caf50;
}

.status-2 {
  background-color: #ffebee;
  color: #f44336;
}