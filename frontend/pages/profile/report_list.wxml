<view class="container">
  <view class="header">
    <text class="title">我上报的动物</text>
  </view>

  <view wx:if="{{!isLoading && reportList.length === 0}}" class="empty-tip">
    <text>您还没有上报过动物信息哦~</text>
  </view>

  <view class="report-list" wx:else>
    <view class="report-card"
          wx:for="{{reportList}}"
          wx:key="id"
          bindtap="goToDetail"
          data-id="{{item.id}}">

      <image class="pet-avatar"
             src="{{item.photoUrl || '/images/default-pet.png'}}"
             mode="aspectFill"></image>

      <view class="report-info">
        <view class="pet-name">
          {{item.petName || '未知动物'}}
          <text class="gender">{{item.gender === 1 ? '♂' : (item.gender === 2 ? '♀' : '')}}</text>
        </view>

        <view class="pet-breed" wx:if="{{item.breed}}">
          品种：{{item.breed}}
        </view>

        <view class="report-location">
          上报地点：{{item.location || '未知'}}
        </view>

        <view class="report-time">
          上报时间：{{item.reportTime || '未知'}}
        </view>

        <view class="status-badge status-{{item.status}}">
          {{item.statusText || '待处理'}}
        </view>
      </view>

    </view>
  </view>
</view>