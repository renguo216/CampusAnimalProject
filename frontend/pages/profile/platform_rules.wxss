page {
  background-color: #FFF8E7;
}

.container {
  padding: 0;
  background-color: #FFF8E7;
  min-height: 100vh;
}

.header {
  padding-top: 200rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.rules-list {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.rule-item {
  background-color: #fff;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.rule-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 35rpx 30rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.arrow {
  font-size: 40rpx;
  color: #999;
  transition: transform 0.3s;
}

.arrow.expanded {
  transform: rotate(90deg);
}

.rule-content {
  padding: 0 30rpx 30rpx 30rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 2;
  background-color: #fafafa;
}