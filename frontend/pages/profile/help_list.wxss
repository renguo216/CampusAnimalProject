page {
  background-color: #FFF8E7;
}

.container {
  padding: 0 30rpx 30rpx 30rpx;
  background-color: #FFF8E7;
}

.header {
  text-align: center;
  padding-top: 30rpx;
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.empty-tip {
  text-align: center;
  color: #999;
  margin-top: 100rpx;
  font-size: 28rpx;
}

.help-list {
  display: flex;
  flex-direction: column;
}

.help-card {
  display: flex;
  align-items: center;
  background-color: transparent;
  padding: 30rpx 0;
  margin-bottom: 30rpx;
  width: 100%;
}

.pet-avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background-color: #eee;
  flex-shrink: 0;
}

.help-info {
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.pet-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.help-type {
  font-size: 28rpx;
  color: #666;
  margin-top: 15rpx;
}

.help-amount {
  font-size: 26rpx;
  color: #ff6b81;
  margin-top: 15rpx;
}

.help-time {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}

.help-status {
  font-size: 24rpx;
  color: #4caf50;
  margin-top: 15rpx;
}