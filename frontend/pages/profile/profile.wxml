<view class="profile-container">
  <view class="header-section">
    <view class="user-info">
      <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" />
      <view class="user-detail">
        <text class="nickname">{{userInfo.nickname || '爱心志愿者'}}</text>
        <view class="user-badges">
          <text class="badge volunteer" wx:if="{{userInfo.role === 'volunteer'}}">🌟 志愿者</text>
          <text class="badge member">⭐ 爱心会员</text>
          <text class="badge level">Lv.{{userInfo.level || 1}}</text>
        </view>
      </view>
      <view class="edit-btn" bindtap="goToEditProfile">
        <text>编辑</text>
      </view>
    </view>

    <view class="stats-row">
      <view class="stat-item" bindtap="viewLikes">
        <text class="stat-num">{{stats.likes || 0}}</text>
        <text class="stat-label">获赞</text>
      </view>
      <view class="stat-item" bindtap="viewFollowing">
        <text class="stat-num">{{stats.following || 0}}</text>
        <text class="stat-label">关注</text>
      </view>
      <view class="stat-item" bindtap="viewFans">
        <text class="stat-num">{{stats.fans || 0}}</text>
        <text class="stat-label">粉丝</text>
      </view>
    </view>
  </view>

  <view class="quick-actions">
    <view class="action-item" bindtap="goToMyReports">
      <view class="action-icon bg-orange">
        <text>📝</text>
      </view>
      <text class="action-text">我上报的</text>
    </view>
    <view class="action-item" bindtap="goToMyHelps">
      <view class="action-icon bg-blue">
        <text>🤝</text>
      </view>
      <text class="action-text">我帮助的</text>
    </view>
    <view class="action-item" bindtap="goToMyAdoptions">
      <view class="action-icon bg-pink">
        <text>🏠</text>
      </view>
      <text class="action-text">我领养的</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goToVolunteerApply">
      <text class="menu-icon">🎖️</text>
      <text class="menu-text">志愿者申请</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToDonationHistory">
      <text class="menu-icon">💝</text>
      <text class="menu-text">捐款记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToPoints">
      <text class="menu-icon">🎁</text>
      <text class="menu-text">积分商城</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToHelpFeedback">
      <text class="menu-icon">❓</text>
      <text class="menu-text">帮助与反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToPlatformRules">
      <text class="menu-icon">📖</text>
      <text class="menu-text">平台规则</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="logout-section">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <view class="tab-bar">
    <view class="tab-bar-item" bindtap="goHome">
      <text class="tab-bar-icon">🏠</text>
      <text class="tab-bar-text">首页</text>
    </view>
    <view class="tab-bar-item" bindtap="goAdoption">
      <text class="tab-bar-icon">❤️</text>
      <text class="tab-bar-text">领养</text>
    </view>
    <view class="tab-bar-item" bindtap="goCommunity">
      <text class="tab-bar-icon">💬</text>
      <text class="tab-bar-text">社区</text>
    </view>
    <view class="tab-bar-item active">
      <text class="tab-bar-icon">👤</text>
      <text class="tab-bar-text">我的</text>
    </view>
  </view>
</view>