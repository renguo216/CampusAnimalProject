page {
  background-color: #FFF8E7;
}

.container {
  padding: 0;
  background-color: #FFF8E7;
  min-height: 100vh;
}

.header {
  padding-top: 200rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.section {
  background-color: #fff;
  border-radius: 0;
  margin-bottom: 30rpx;
  width: 100%;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.help-list {
  display: flex;
  flex-direction: column;
}

.help-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.help-item:last-child {
  border-bottom: none;
}

.help-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.arrow {
  font-size: 36rpx;
  color: #999;
  transition: transform 0.3s;
}

.arrow.expanded {
  transform: rotate(90deg);
}

.help-answer {
  margin-top: 20rpx;
  padding-top: 20rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.form-item {
  margin-bottom: 30rpx;
  padding: 0 30rpx;
}

.feedback-input {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.contact-input {
  width: 100%;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.submit-btn {
  margin: 0 30rpx 30rpx 30rpx;
  width: calc(100% - 60rpx);
  background-color: #4caf50;
  color: #fff;
  padding: 25rpx 0;
  border-radius: 50rpx;
  font-size: 30rpx;
  border: none;
}

.history-list {
  display: flex;
  flex-direction: column;
}

.history-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-item:last-child {
  border-bottom: none;
}

.history-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.history-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 15rpx;
}

.history-status {
  font-size: 24rpx;
  color: #4caf50;
  margin-top: 10rpx;
}