page {
  background-color: #fdf8f3;
  min-height: 100vh;
}

.edit-profile-container {
  padding-top: var(--status-bar-height);
  padding-bottom: 120rpx;
  min-height: 100vh;
}

.form-section {
  margin: 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 15rpx;
}

.form-input {
  width: 100%;
  height: 90rpx;
  background-color: #fdf8f3;
  border-radius: 15rpx;
  padding: 0 25rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.form-value {
  width: 100%;
  height: 90rpx;
  background-color: #f5f5f5;
  border-radius: 15rpx;
  padding: 0 25rpx;
  font-size: 28rpx;
  color: #999999;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 150rpx;
  background-color: #fdf8f3;
  border-radius: 15rpx;
  padding: 25rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.save-btn {
  margin: 30rpx;
  height: 100rpx;
  background: linear-gradient(90deg, #d46b08 0%, #ff9f00 100%);
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}