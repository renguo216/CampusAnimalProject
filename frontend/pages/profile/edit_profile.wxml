<view class="edit-profile-container">
  <view class="form-section">
    <view class="form-title">头像</view>
    <view class="avatar-section">
      <image class="avatar-image" src="{{tempAvatarUrl || '/pages/login/images/image1.jpg'}}" mode="aspectFill" />
      <view class="change-avatar-btn" bindtap="chooseAvatar">
        <text>点击更换头像</text>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="form-item">
      <view class="form-label">昵称</view>
      <input 
        class="form-input" 
        placeholder="请输入昵称" 
        value="{{userInfo.nickname}}" 
        bindinput="onNicknameInput"
        maxlength="20"
      />
    </view>

    <view class="form-item">
      <view class="form-label">手机号</view>
      <input 
        class="form-input" 
        type="number" 
        placeholder="请输入手机号" 
        value="{{userInfo.phone}}" 
        bindinput="onPhoneInput"
        maxlength="11"
      />
    </view>

    <view class="form-item">
      <view class="form-label">学号/工号</view>
      <input 
        class="form-input" 
        placeholder="请输入校园学号或工号（选填）" 
        value="{{userInfo.identityNo}}" 
        bindinput="onIdentityInput"
        maxlength="20"
      />
    </view>
  </view>

  <view class="save-btn-container">
    <button class="save-btn" bindtap="saveUserInfo">保存</button>
  </view>
</view>