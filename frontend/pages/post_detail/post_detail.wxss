.detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  padding-top: 60rpx;
  background-color: #ffffff;
  z-index: 100;
}

.header-content {
  display: flex;
  align-items: center;
  padding: 0 30rpx;
}

.back-btn {
  width: 70rpx;
  height: 70rpx;
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn text {
  font-size: 36rpx;
  color: #ffffff;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  margin-left: 20rpx;
}

.scroll-content {
  height: 100vh;
  padding-top: 200rpx;
}

.post-card {
  width: 90%;
  margin: 20rpx auto;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 20rpx;
}

.post-author {
  flex: 1;
}

.author-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.author-time {
  font-size: 24rpx;
  color: #999999;
}

.post-content {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.6;
  margin-bottom: 25rpx;
  white-space: pre-wrap;
}

.post-images {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  margin-bottom: 25rpx;
}

.post-image {
  width: 100%;
  border-radius: 12rpx;
}

.post-actions {
  display: flex;
  justify-content: flex-start;
  gap: 60rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.action-icon {
  font-size: 40rpx;
}

.action-count {
  font-size: 28rpx;
  color: #666666;
}

.action-item.liked .action-icon {
  transform: scale(1.1);
}

.comments-section {
  width: 90%;
  margin: 20rpx auto;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 25rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-item {
  display: flex;
  margin-bottom: 25rpx;
}

.comment-item:last-child {
  margin-bottom: 0;
}

.comment-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  margin-right: 20rpx;
}

.comment-body {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.comment-author {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
}

.comment-time {
  font-size: 22rpx;
  color: #999999;
}

.comment-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
}

.empty-section {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #999999;
}

.comment-input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1rpx solid #f5f5f5;
  z-index: 100;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  padding: 0 30rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 20rpx;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #999999;
}

.send-btn.active {
  background-color: #ff9f00;
  color: #ffffff;
}
