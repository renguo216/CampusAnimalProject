/* pages/donation/donation.wxss */
page {
  background-color: #fdf8f3;
  min-height: 100vh;
}

.donation-container {
  padding-bottom: 140rpx;
}

.header {
  padding: 60rpx 30rpx 30rpx;
  background-color: #ffffff;
  text-align: center;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.banner {
  margin: 20rpx 30rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%);
  border-radius: 25rpx;
  padding: 40rpx;
  text-align: center;
  color: #ffffff;
}

.banner-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.banner-desc {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 25rpx;
}

.total-info {
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 15rpx;
  padding: 20rpx;
}

.total-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.total-amount {
  font-size: 40rpx;
  font-weight: bold;
}

.section {
  background-color: #ffffff;
  margin: 0 30rpx 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.project-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.project-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 15rpx;
}

.project-icon {
  width: 80rpx;
  height: 80rpx;
  background-color: #ffe4e4;
  border-radius: 15rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}

.project-info {
  flex: 1;
}

.project-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 5rpx;
}

.project-desc {
  font-size: 24rpx;
  color: #999999;
}

.project-progress {
  width: 120rpx;
  text-align: right;
}

.progress-bar {
  height: 8rpx;
  background-color: #eee;
  border-radius: 4rpx;
  margin-bottom: 5rpx;
}

.progress-fill {
  height: 100%;
  background-color: #ff6b6b;
  border-radius: 4rpx;
}

.progress-text {
  font-size: 22rpx;
  color: #999999;
}

.amount-options {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.amount-btn {
  padding: 18rpx 35rpx;
  background-color: #f5f5f5;
  border-radius: 50rpx;
  font-size: 28rpx;
  color: #333333;
}

.amount-btn.active {
  background-color: #ff6b6b;
  color: #ffffff;
}

.custom-amount {
  margin-top: 10rpx;
}

.amount-input {
  width: 100%;
  height: 80rpx;
  background-color: #f9f9f9;
  border-radius: 15rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.message-input {
  width: 100%;
  height: 150rpx;
  background-color: #f9f9f9;
  border-radius: 15rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.donate-btn {
  margin: 30rpx;
  height: 100rpx;
  background: linear-gradient(90deg, #ff6b6b 0%, #ee5a5a 100%);
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(238, 90, 90, 0.3);
}

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  background-color: #ffffff;
  padding: 15rpx 0 35rpx;
  box-shadow: 0 -4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tab-bar-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.tab-bar-text {
  font-size: 22rpx;
  color: #999999;
}