.detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  padding-top: 60rpx;
  background-color: #ffffff;
  z-index: 100;
}

.header-content {
  display: flex;
  align-items: center;
  padding: 0 30rpx;
}

.back-btn {
  width: 70rpx;
  height: 70rpx;
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn text {
  font-size: 36rpx;
  color: #ffffff;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333333;
  margin-left: 10rpx;
  margin-top: 10rpx;
}

.scroll-content {
  height: auto;
  min-height: 100vh;
  padding-top: 200rpx;
}

.image-scroll {
  width: 100%;
  height: 600rpx;
  white-space: nowrap;
}

.image-container {
  display: inline-flex;
  flex-direction: row;
  height: 100%;
}

.detail-image {
  width: 100vw;
  height: 100%;
  object-fit: cover;
  border-radius: 0;
}

.detail-info {
  background-color: #ffffff;
  margin: 20rpx 30rpx 30rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  position: relative;
  z-index: 1;
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.rescue-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  flex: 1;
  margin-right: 20rpx;
}

.status-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-tag.pending {
  background-color: #fff3e0;
  color: #ff9f00;
}

.status-tag.processing {
  background-color: #e3f2fd;
  color: #1976d2;
}

.status-tag.resolved {
  background-color: #e8f5e9;
  color: #388e3c;
}

.info-row {
  display: flex;
  margin-bottom: 20rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 28rpx;
  color: #999999;
  width: 140rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  flex: 1;
}

.info-value.description {
  color: #666666;
  line-height: 1.6;
}

.action-section {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 20rpx;
  padding: 0 30rpx;
  display: flex;
  justify-content: center;
  z-index: 99;
}

.action-btn {
  flex: 1;
  max-width: 600rpx;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.primary {
  background: linear-gradient(135deg, #ff9f00 0%, #ff6b00 100%);
}

.action-btn.primary text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
}
