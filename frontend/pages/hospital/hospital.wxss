/* pages/hospital/hospital.wxss */
page {
  background-color: #fdf8f3;
  min-height: 100vh;
}

.hospital-container {
  padding-bottom: 120rpx;
}

.header {
  padding: 60rpx 30rpx 30rpx;
  background-color: #ffffff;
  text-align: center;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.map-area {
  margin: 20rpx 30rpx;
  height: 300rpx;
  background-color: #e8f4f8;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}

.map-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.map-icon {
  font-size: 60rpx;
  margin-bottom: 15rpx;
}

.map-text {
  font-size: 28rpx;
  color: #999999;
}

.location-badge {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  background-color: rgba(255, 255, 255, 0.9);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.hospital-list {
  padding: 0 30rpx;
}

.hospital-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.hospital-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.hospital-address {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 15rpx;
}

.hospital-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.tag {
  padding: 8rpx 20rpx;
  background-color: #f0f0f0;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #666666;
}

.hospital-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.distance {
  font-size: 24rpx;
  color: #999999;
}

.phone {
  font-size: 26rpx;
  color: #ff9f00;
}

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  background-color: #ffffff;
  padding: 15rpx 0 35rpx;
  box-shadow: 0 -4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tab-bar-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.tab-bar-text {
  font-size: 22rpx;
  color: #999999;
}