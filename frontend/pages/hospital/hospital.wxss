/* pages/hospital/hospital.wxss */
page {
  background-color: #fdf8f3;
  min-height: 100vh;
}

.hospital-container {
  padding-bottom: 120rpx;
}

.header {
  padding: 160rpx 30rpx 30rpx;
  background-color: #ffffff;
  text-align: center;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.filter-area {
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  margin-bottom: 20rpx;
}

.filter-tabs {
  display: flex;
  justify-content: space-between;
  gap: 15rpx;
}

.filter-tab {
  flex: 1;
  height: 70rpx;
  background-color: #f5f5f5;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-tab text {
  font-size: 26rpx;
  color: #666666;
}

.filter-tab.active {
  background-color: #ff9f00;
}

.filter-tab.active text {
  color: #ffffff;
  font-weight: bold;
}

.filter-result {
  margin-top: 20rpx;
  text-align: center;
}

.result-text {
  font-size: 24rpx;
  color: #999999;
}

.hospital-list {
  padding: 0 30rpx;
  height: calc(100vh - 400rpx);
}

.hospital-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.hospital-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.hospital-address {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 15rpx;
}

.hospital-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.tag {
  padding: 8rpx 20rpx;
  background-color: #f0f0f0;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #666666;
}

.hospital-footer {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  gap: 400rpx;
}

.distance {
  font-size: 24rpx;
  color: #ff9f00;
  font-weight: bold;
}

.phone {
  font-size: 26rpx;
  color: #ff9f00;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
}

.empty-tip text {
  font-size: 28rpx;
  color: #999999;
}

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  background-color: #ffffff;
  padding: 15rpx 0 35rpx;
  box-shadow: 0 -4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tab-bar-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.tab-bar-text {
  font-size: 22rpx;
  color: #999999;
}
