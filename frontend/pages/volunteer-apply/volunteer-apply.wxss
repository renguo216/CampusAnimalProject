page {
  background-color: #FFF8E7;
  min-height: 100vh;
}

.volunteer-container {
  padding-bottom: 60rpx;
  min-height: 100vh;
}

.form-content {
  padding: 30rpx;
}

.checkbox-wrap {
  padding: 10rpx 0;
}

.checkbox-label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

.submit-area {
  padding: 30rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 30rpx 30rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: #333333;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.placeholder {
  width: 60rpx;
}

.intro-section {
  text-align: center;
  padding: 50rpx 30rpx;
  background: linear-gradient(135deg, #fff3e6 0%, #ffe4c4 100%);
  margin: 0 30rpx 30rpx;
  border-radius: 20rpx;
}

.intro-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.intro-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #8b4513;
  margin-bottom: 15rpx;
}

.intro-desc {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.user-info-section {
  background-color: #ffffff;
  margin: 0 30rpx 30rpx;
  border-radius: 20rpx;
  padding: 30rpx;
}

.user-info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.user-info-item:last-child {
  border-bottom: none;
}

.user-info-label {
  font-size: 28rpx;
  color: #666666;
}

.user-info-value {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.form-section {
  background-color: #ffffff;
  margin: 0 30rpx 30rpx;
  border-radius: 20rpx;
  padding: 30rpx;
}

.form-item {
  margin-bottom: 35rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 15rpx;
}

.form-label .required {
  color: #ff4d4f;
}

.form-input {
  width: 100%;
  height: 90rpx;
  background-color: #FFF8E7;
  border-radius: 15rpx;
  padding: 0 25rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  background-color: #FFF8E7;
  border-radius: 15rpx;
  padding: 25rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.form-hint {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
}

.checkbox-group {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.checkbox-item {
  padding: 18rpx 30rpx;
  background-color: #f5f5f5;
  border-radius: 50rpx;
  font-size: 26rpx;
  color: #666666;
}

.checkbox-item.checked {
  background-color: #ff9f00;
  color: #ffffff;
}

.time-options {
  display: flex;
  gap: 20rpx;
}

.time-item {
  flex: 1;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 15rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
}

.time-item.checked {
  background-color: #52c41a;
  color: #ffffff;
}

.agreement-section {
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 20rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666666;
}

.submit-btn {
  margin: 0 30rpx;
  height: 100rpx;
  background: linear-gradient(90deg, #d46b08 0%, #ff9f00 100%);
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(212, 107, 8, 0.3);
}

.contact-section {
  text-align: center;
  margin-top: 30rpx;
}

.contact-text {
  font-size: 24rpx;
  color: #999999;
}
