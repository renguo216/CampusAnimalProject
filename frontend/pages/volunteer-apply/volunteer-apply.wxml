<view class="volunteer-container">
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text>←</text>
    </view>
    <text class="header-title">志愿者申请</text>
    <view class="placeholder"></view>
  </view>

  <view class="intro-section">
    <text class="intro-icon">🐾</text>
    <text class="intro-title">加入志愿者团队</text>
    <text class="intro-desc">成为校园宠物救助志愿者，用爱心守护每一个小生命</text>
  </view>

  <view class="user-info-section">
    <view class="user-info-item">
      <text class="user-info-label">姓名</text>
      <text class="user-info-value">{{userInfo.nickname || '未设置'}}</text>
    </view>
    <view class="user-info-item">
      <text class="user-info-label">手机号</text>
      <text class="user-info-value">{{userInfo.phone_number || '未设置'}}</text>
    </view>
  </view>

  <view class="form-section">
    <view class="form-item">
      <text class="form-label">申请理由 <text class="required">*</text></text>
      <textarea 
        class="form-textarea" 
        placeholder="请输入您申请成为志愿者的理由（最多500字）..."
        bindinput="onContentInput"
        value="{{applyContent}}"
        maxlength="500"
      ></textarea>
    </view>
  </view>

  <view class="agreement-section">
    <view class="checkbox-group">
      <checkbox-group bindchange="onAgreementChange">
        <label class="agreement-label">
          <checkbox value="agree" checked="{{isAgreed}}" />
          <text>我已阅读并同意《志愿者服务协议》和《隐私政策》</text>
        </label>
      </checkbox-group>
    </view>
  </view>

  <button 
    class="submit-btn" 
    bindtap="submitApplication"
    disabled="{{loading}}"
  >
    <text>{{loading ? '提交中...' : '提交申请'}}</text>
  </button>

  <view class="contact-section">
    <text class="contact-text">如有疑问，请联系志愿者管理团队</text>
  </view>
</view>