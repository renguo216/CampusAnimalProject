page {
  background-color: #fcfcfc; 
  height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  height: 100vh;
  padding: 12vh 50rpx 10vh 50rpx;
  box-sizing: border-box;
}

.logo-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.logo-placeholder {
  width: 400rpx;
  height: 400rpx;
  background-color: #ffffff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(255, 204, 0, 0.15);
  overflow: hidden;
  margin-bottom: 0;
}

.circle-img-fill {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #0e0707;
  margin-top: 0rpx;
  text-align: center;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.form-box {
  width: 100%;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.agreement-box {
  margin-top: 10rpx;
  margin-bottom: 50rpx;
}

.checkbox-label {
  display: flex;
  align-items: center;
}

checkbox .wx-checkbox-input {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50% !important;
  border: 2rpx solid #cccccc;
  background: #ffffff;
  box-sizing: border-box;
}

checkbox .wx-checkbox-input.wx-checkbox-input-checked {
  border-color: #FFCC00 !important;
  background: #FFCC00 !important;
}

checkbox .wx-checkbox-input.wx-checkbox-input-checked::before {
  color: #ffffff !important;
  font-size: 28rpx;
}

.agreement-text {
  font-size: 24rpx;
  color: #777777;
  margin-left: 18rpx;
}

.wechat-quick-btn {
  width: 100% !important;
  height: 96rpx;
  background-color: #ffffff;
  color: #07c160;
  border: 2rpx solid #07c160;
  border-radius: 50rpx;
  font-size: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.05);
}