<view class="reimbursement-container">
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text>←</text>
    </view>
    <text class="header-title">费用报销</text>
    <view class="placeholder"></view>
  </view>

  <view class="intro-section">
    <view class="intro-icon">💰</view>
    <text class="intro-title">报销申请</text>
    <text class="intro-desc">为您的爱心付出提供费用支持</text>
  </view>

  <view class="tabs">
    <view class="tab-item {{activeTab === 'apply' ? 'active' : ''}}" bindtap="switchTab" data-tab="apply">
      <text>申请报销</text>
    </view>
    <view class="tab-item {{activeTab === 'records' ? 'active' : ''}}" bindtap="switchTab" data-tab="records">
      <text>报销记录</text>
    </view>
  </view>

  <view class="apply-form" wx:if="{{activeTab === 'apply'}}">
    <view class="form-item">
      <text class="form-label">报销类型</text>
      <view class="type-options">
        <view class="type-item {{reimburseType === 'medical' ? 'active' : ''}}" bindtap="selectType" data-type="medical">
          <text>🏥 医疗费用</text>
        </view>
        <view class="type-item {{reimburseType === 'food' ? 'active' : ''}}" bindtap="selectType" data-type="food">
          <text>🍖 食物费用</text>
        </view>
        <view class="type-item {{reimburseType === 'transport' ? 'active' : ''}}" bindtap="selectType" data-type="transport">
          <text>🚗 交通费用</text>
        </view>
        <view class="type-item {{reimburseType === 'supplies' ? 'active' : ''}}" bindtap="selectType" data-type="supplies">
          <text>🧸 物资费用</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">关联任务</text>
      <view class="task-select" bindtap="selectTask">
        <text>{{selectedTask || '请选择关联的救助任务'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">报销金额</text>
      <view class="amount-input">
        <text class="currency">¥</text>
        <input class="amount-field" type="digit" placeholder="0.00" bindinput="onAmountInput" value="{{amount}}" />
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">费用说明</text>
      <textarea class="form-textarea" placeholder="请详细描述费用产生的原因..." bindinput="onDescInput" value="{{description}}" />
    </view>

    <view class="form-item">
      <text class="form-label">上传凭证</text>
      <view class="upload-area">
        <view class="upload-item add-btn" bindtap="chooseImage" wx:if="{{vouchers.length < 5}}">
          <text class="add-icon">📷</text>
          <text class="add-text">添加</text>
        </view>
        <view class="upload-item" wx:for="{{vouchers}}" wx:key="index">
          <image src="{{item}}" mode="aspectFill" />
          <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}">×</view>
        </view>
      </view>
    </view>

    <button class="submit-btn" bindtap="submitApplication">提交申请</button>
  </view>

  <view class="records-list" wx:if="{{activeTab === 'records'}}">
    <view class="record-item" wx:for="{{records}}" wx:key="id">
      <view class="record-header">
        <text class="record-type">{{item.typeText}}</text>
        <text class="record-status {{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="record-content">
        <view class="record-row">
          <text class="record-label">关联任务：</text>
          <text class="record-value">{{item.taskName}}</text>
        </view>
        <view class="record-row">
          <text class="record-label">报销金额：</text>
          <text class="record-amount">¥{{item.amount}}</text>
        </view>
        <view class="record-row">
          <text class="record-label">申请时间：</text>
          <text class="record-value">{{item.applyTime}}</text>
        </view>
        <view class="record-row" wx:if="{{item.reviewTime}}">
          <text class="record-label">审核时间：</text>
          <text class="record-value">{{item.reviewTime}}</text>
        </view>
      </view>
      <view class="record-actions">
        <button class="detail-btn" bindtap="viewDetail" data-id="{{item.id}}">查看详情</button>
      </view>
    </view>

    <view class="empty-tip" wx:if="{{records.length === 0}}">
      <text>暂无报销记录</text>
    </view>
  </view>
</view>