page {
  background-color: #fdf8f3;
  min-height: 100vh;
}

.reimbursement-container {
  padding-bottom: 60rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 30rpx 30rpx;
  background-color: #ffffff;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: #333333;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.placeholder {
  width: 60rpx;
}

.intro-section {
  text-align: center;
  padding: 50rpx 30rpx;
  background: linear-gradient(135deg, #e6fff7 0%, #b3f5d6 100%);
}

.intro-icon {
  font-size: 60rpx;
  margin-bottom: 15rpx;
}

.intro-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #135d3b;
  margin-bottom: 10rpx;
}

.intro-desc {
  display: block;
  font-size: 26rpx;
  color: #2d8659;
}

.tabs {
  display: flex;
  margin: 30rpx;
  background-color: #ffffff;
  border-radius: 15rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  padding: 25rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  position: relative;
}

.tab-item.active {
  color: #52c41a;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #52c41a;
  border-radius: 3rpx;
}

.apply-form {
  padding: 0 30rpx;
}

.form-item {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.type-options {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.type-item {
  padding: 18rpx 30rpx;
  background-color: #f5f5f5;
  border-radius: 50rpx;
  font-size: 26rpx;
  color: #666666;
}

.type-item.active {
  background-color: #52c41a;
  color: #ffffff;
}

.task-select {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx;
  background-color: #fdf8f3;
  border-radius: 15rpx;
  font-size: 28rpx;
  color: #333333;
}

.task-select .arrow {
  font-size: 36rpx;
  color: #cccccc;
}

.amount-input {
  display: flex;
  align-items: center;
  background-color: #fdf8f3;
  border-radius: 15rpx;
  padding: 25rpx;
}

.currency {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-right: 15rpx;
}

.amount-field {
  flex: 1;
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.form-textarea {
  width: 100%;
  height: 150rpx;
  background-color: #fdf8f3;
  border-radius: 15rpx;
  padding: 25rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.upload-item {
  width: 150rpx;
  height: 150rpx;
  border-radius: 15rpx;
  overflow: hidden;
  position: relative;
}

.upload-item image {
  width: 100%;
  height: 100%;
}

.add-btn {
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 2rpx dashed #ddd;
}

.add-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 22rpx;
  color: #999999;
}

.delete-btn {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 35rpx;
  height: 35rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
}

.submit-btn {
  margin-top: 40rpx;
  height: 100rpx;
  background: linear-gradient(90deg, #389e0d 0%, #52c41a 100%);
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(82, 196, 26, 0.3);
}

.records-list {
  padding: 0 30rpx;
}

.record-item {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-type {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.record-status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.record-status.pending {
  background-color: #fff7e6;
  color: #fa8c16;
}

.record-status.approved {
  background-color: #f6ffed;
  color: #52c41a;
}

.record-status.rejected {
  background-color: #fff1f0;
  color: #ff4d4f;
}

.record-status.completed {
  background-color: #e6f7ff;
  color: #1890ff;
}

.record-content {
  margin-bottom: 20rpx;
}

.record-row {
  display: flex;
  margin-bottom: 12rpx;
}

.record-row:last-child {
  margin-bottom: 0;
}

.record-label {
  font-size: 26rpx;
  color: #999999;
  width: 180rpx;
}

.record-value {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
}

.record-amount {
  flex: 1;
  font-size: 28rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.record-actions {
  display: flex;
  justify-content: flex-end;
}

.detail-btn {
  padding: 12rpx 30rpx;
  background-color: #f5f5f5;
  color: #666666;
  border-radius: 30rpx;
  font-size: 24rpx;
  border: none;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: #999999;
}